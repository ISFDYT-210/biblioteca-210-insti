{
  "version": 2,
  "builds": [
    {
      "src": "biblioteca_digital/biblioteca_digital/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "biblioteca_digital/biblioteca_digital/wsgi.py"
    }
  ]
}
